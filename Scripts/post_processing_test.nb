Cell["Get the string to put in pgfplot settings.", "Subsubsection",ExpressionUUID->"b6f06d28-6998-4260-bf42-5107570672f9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "treeString", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"treeString", "=", "\"\<\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"treeString", "=", 
       RowBox[{"treeString", "<>", "\"\<{$[\>\""}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"treeString", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"SameQ", "[", 
             RowBox[{"j", ",", 
              RowBox[{
               RowBox[{"Dimensions", "[", "sortedUniqueTreeVecs", "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", 
            RowBox[{"treeString", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"sortedUniqueTreeVecs", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}]}], ",", 
            RowBox[{"treeString", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"sortedUniqueTreeVecs", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}], 
             "<>", "\"\<,\\!\>\""}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
        ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", 
          RowBox[{
           RowBox[{"Dimensions", "[", "sortedUniqueTreeVecs", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"treeString", "=", 
       RowBox[{"treeString", "<>", "\"\<]$}\>\""}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"\[Not]", 
         RowBox[{"SameQ", "[", 
          RowBox[{"i", ",", 
           RowBox[{
            RowBox[{"Dimensions", "[", "sortedUniqueTreeVecs", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ",", 
        RowBox[{"treeString", "=", 
         RowBox[{"treeString", "<>", "\"\<,\>\""}]}]}], "]"}], ";"}], 
     "\[IndentingNewLine]", ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "sortedUniqueTreeVecs", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<ymin=\>\"", ",", "0.5", ",", "\"\<,\\n\>\"", 
   ",", "\"\<ymax=\>\"", ",", 
   RowBox[{
    RowBox[{"Length", "[", "sortedUniqueTreeVecs", "]"}], "-", "0.5"}], 
   ",", "\"\<,\\n\>\"", ",", 
   RowBox[{"\"\<ytick=\>\"", "<>", 
    RowBox[{"StringReplace", "[", 
     RowBox[{
      RowBox[{"ToString", "[", 
       RowBox[{"Table", "[", 
        RowBox[{"i", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{
            RowBox[{"Length", "[", "sortedUniqueTreeVecs", "]"}], "-", 
            "1"}]}], "}"}]}], "]"}], "]"}], ",", 
      RowBox[{"\"\< \>\"", "->", "\"\<\>\""}]}], "]"}], 
    "<>", "\"\<,\\n\>\""}], ",", 
   RowBox[{"\"\<yticklabels={\>\"", "<>", "treeString", 
    "<>", "\"\<},\>\""}]}], "]"}]}], "Input",
 CellLabel->
