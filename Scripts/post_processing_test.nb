Cell[BoxData[{
 RowBox[{
  RowBox[{"uniqueTreeVecs", "=", 
   RowBox[{
    RowBox[{"DeleteDuplicatesBy", "[", 
     RowBox[{
      RowBox[{"#", "[", 
       RowBox[{"[", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}], "]"}], "&"}], "]"}],
     "@", 
    RowBox[{"Flatten", "[", 
     RowBox[{"treeVecs", ",", "1"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sortedUniqueTreeVecs", "=", 
   RowBox[{"SortBy", "[", 
    RowBox[{"uniqueTreeVecs", ",", 
     RowBox[{
      RowBox[{"GetPhotonNumber", "[", "#", "]"}], "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"treeVecsIndexing", "=", 
   RowBox[{"(", 
    RowBox[{"treeVecs", "/.", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"sortedUniqueTreeVecs", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "\[Rule]", "Indeterminate"}], "}"}],
        ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"sortedUniqueTreeVecs", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "\[Rule]", 
          RowBox[{"(", 
           RowBox[{"i", "-", "1"}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "2", ",", 
           RowBox[{"Length", "[", "sortedUniqueTreeVecs", "]"}]}], "}"}]}], 
        "]"}]}], "]"}]}], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{"doExport", ",", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], "<>", "\"\<\\\\tex\\\\\>\"",
           "<>", "binaryDataPath", "<>", "\"\<_\>\"", "<>", "fileHash", 
          "<>", "\"\<\\\\\>\"", "<>", "filePrefix", "<>", "\"\<treeVecs\>\"", 
          "<>", "fileSuffix", "<>", "\"\<\\\\\>\"", "<>", "filePrefix", 
          "<>", "\"\<treeVecs_reencodingError\>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"reencodingError", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "<>", "fileSuffix", 
          "<>", "\"\<.csv\>\""}], ",", 
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"Ltot", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "/", "1*^3"}], ",", 
              RowBox[{"treeVecsIndexing", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "}"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<Ltot\>\"", ",", "\"\<treeIndexing\>\""}], "}"}]}], 
          "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "reencodingError", "]"}]}], "}"}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
     "Print", "[", "\"\<Tree vector data saved in .csv format!\>\"", "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"RunProcess", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<pwsh\>\"", ",", "\"\<-File\>\"", ",", 
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], 
          "<>", "\"\<\\\\process-csv.ps1\>\""}]}], "}"}], 
       ",", "\"\<StandardOutput\>\""}], "]"}], ";"}]}], "\[IndentingNewLine]",
    "]"}], ";"}], "\[IndentingNewLine]", 
