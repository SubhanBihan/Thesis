Cell["\<\
Unique tree vectors, sorted with ascending order w.r.t photon number.\
\>", "Subsubsection",ExpressionUUID->"eaa1d645-ccdf-4c25-9644-89e95a49f218"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"uniqueTreeVecs", "=", 
   RowBox[{
    RowBox[{"DeleteDuplicatesBy", "[", 
     RowBox[{
      RowBox[{"#", "[", 
       RowBox[{"[", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}], "]"}], "&"}], "]"}],
     "@", 
    RowBox[{"Flatten", "[", 
     RowBox[{"treeVecs", ",", "1"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sortedUniqueTreeVecs", "=", 
   RowBox[{"SortBy", "[", 
    RowBox[{"uniqueTreeVecs", ",", 
     RowBox[{
      RowBox[{"GetPhotonNumber", "[", "#", "]"}], "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"treeVecsIndexing", "=", 
   RowBox[{"(", 
    RowBox[{"treeVecs", "/.", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"sortedUniqueTreeVecs", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "\[Rule]", "Indeterminate"}], "}"}],
        ",", 
