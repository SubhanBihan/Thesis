Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "treeString", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"treeString", "=", "\"\<\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"treeString", "=", 
       RowBox[{"treeString", "<>", "\"\<{$[\>\""}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"treeString", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"SameQ", "[", 
             RowBox[{"j", ",", 
              RowBox[{
               RowBox[{"Dimensions", "[", "sortedUniqueTreeVecs", "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", 
            RowBox[{"treeString", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"sortedUniqueTreeVecs", "[", 
