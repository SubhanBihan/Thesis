          RowBox[{
           RowBox[{"Dimensions", "[", "sortedUniqueTreeVecs", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"treeString", "=", 
       RowBox[{"treeString", "<>", "\"\<]$}\>\""}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"\[Not]", 
         RowBox[{"SameQ", "[", 
          RowBox[{"i", ",", 
           RowBox[{
            RowBox[{"Dimensions", "[", "sortedUniqueTreeVecs", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ",", 
