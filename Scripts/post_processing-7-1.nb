            RowBox[{"treeString", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"sortedUniqueTreeVecs", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}], 
             "<>", "\"\<,\\!\>\""}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
        ",", 
        RowBox[{"{", 
